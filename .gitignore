# MemonBook ERP — Git Ignore

# Secrets / generated keys — NEVER commit
data/.keys
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# SQLite / SQLCipher databases
data/*.db
data/*.db-shm
data/*.db-wal

# Data directories
data/attachments/*
!data/attachments/.gitkeep
data/backups/
data/exports/
data/logs/

# Flet build output
build/

# OS
.DS_Store
Thumbs.db
*.~lock.*

# IDE
.vscode/
.idea/
*.swp
*.swo
