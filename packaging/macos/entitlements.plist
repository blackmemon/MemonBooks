<?xml version="1.0" encoding="UTF-8"?>
<!--
  App Sandbox entitlements, required for Mac App Store submission
  (Section 7). Grants only what MemonBooks actually needs: reading and
  writing its own SQLite database and log files under the sandboxed
  container's Application Support directory (no broad filesystem,
  network, camera, microphone, or hardware access).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
