{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemonBook ERP",
  "version": "1.0.0",
  "identifier": "com.memonenterprises.memonbook",

  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MemonBook ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "pages/login.html",
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' http://127.0.0.1:8765; img-src 'self' data:"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Memon Enterprises",
    "copyright": "© 2025 Memon Enterprises",
    "category": "Business",
    "shortDescription": "Offline Accounting & HR System",
    "longDescription": "MemonBook ERP — Complete offline accounting, purchases, sales, payments, and HR payroll system with AES-256 encrypted database.",

    "linux": {
      "deb": {
        "depends": ["libsqlcipher0", "libssl3"]
      }
    },

    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {}
    },

    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },

    "android": {
      "minSdkVersion": 24
    },

    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },

  "plugins": {
    "shell": {
      "open": false
    },
    "dialog": {
      "open": true,
      "save": true
    },
    "fs": {
      "scope": ["$APPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**"]
    },
    "http": {
      "scope": ["http://127.0.0.1:8765/**"]
    },
    "notification": {
      "all": true
    }
  }
}
